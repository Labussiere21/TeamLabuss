{
  "name": "Back Office Labussière",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install flask beautifulsoup4",
  "postStartCommand": "sleep 3 && nohup python admin.py > /tmp/admin.log 2>&1 &",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "Back Office Admin",
      "onAutoForward": "openBrowser"
    }
  }
}
